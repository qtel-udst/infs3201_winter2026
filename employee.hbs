<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Employee Details</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <h1>Employee Details</h1>

  <p>Name: {{employee.name}}</p>
  <p>Phone: {{employee.phone}}</p>

  <p><a href="/edit/{{employee.employeeId}}">Edit Details</a></p>

  <h2>Shifts</h2>

  {{#if shifts.length}}
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Start Time</th>
          <th>End Time</th>
        </tr>
      </thead>
      <tbody>
        {{#each shifts}}
          <tr>
            <td>{{this.date}}</td>

            {{#if this.startBeforeNoon}}
              <td class="morning">{{this.startTime}}</td>
            {{else}}
              <td>{{this.startTime}}</td>
            {{/if}}

            {{#if this.endBeforeNoon}}
              <td class="morning">{{this.endTime}}</td>
            {{else}}
              <td>{{this.endTime}}</td>
            {{/if}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No shifts assigned.</p>
  {{/if}}

  <p><a href="/">Back</a></p>
</body>
</html>