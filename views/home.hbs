<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Employees</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <h1>List of Employees</h1>

  <p>Logged in as {{username}}</p>
  <p><a href="/logout">Logout</a></p>

  <ul>
    {{#each employees}}
      <li><a href="/employee/{{this._id}}">{{this.name}}</a></li>
    {{/each}}
  </ul>
</body>
</html>