<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Employee Details</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <h1>Employee Details</h1>

  <p>Logged in as {{username}}</p>
  <p><a href="/logout">Logout</a></p>

  <p>Name: {{employee.name}}</p>
  <p>Phone: {{employee.phone}}</p>

  {{#if employee.photoFilename}}
    <p><img src="/photo/{{employee._id}}" alt="{{employee.name}}" width="200" /></p>
  {{/if}}

  <p><a href="/edit/{{employee._id}}">Edit Details</a></p>

  <h2>Shifts</h2>

  {{#if employee.shifts.length}}
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Start Time</th>
          <th>End Time</th>
        </tr>
      </thead>
      <tbody>
        {{#each employee.shifts}}
          <tr>
            <td>{{this.date}}</td>
            <td>{{this.startTime}}</td>
            <td>{{this.endTime}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>No shifts assigned.</p>
  {{/if}}

  <p><a href="/">Back</a></p>
</body>
</html>